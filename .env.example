# Copy to `.env` locally (never commit `.env`).
# On Render, set variables in the dashboard — do NOT put real passwords in this file.

# Required when DEBUG=False (generate: django.core.management.utils.get_random_secret_key)
SECRET_KEY=

# Use False on Render/production
DEBUG=True

# Comma-separated hosts
ALLOWED_HOSTS=127.0.0.1,localhost,your-app.onrender.com

# This project uses SQLite only — delete DATABASE_URL from Render if a Postgres URL is still set.

# Gmail (App Password) — optional; without these, emails print to the console locally
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

CONTACT_RECIPIENT_EMAIL=
